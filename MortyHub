                    Size             = UDim2.new(1,0,0, desc and 44 or 32),
                    BackgroundColor3 = Theme.BG_Element,
                    BorderSizePixel  = 0,
                    LayoutOrder      = layoutOrder,
                    Parent           = Section,
                })
                New("UICorner",  { CornerRadius = UDim.new(0,6) }).Parent = row
                New("UIStroke",  { Color = Theme.Border, Thickness = 1 }).Parent = row
                layoutOrder += 1

                New("TextLabel", {
                    Text         = name,
                    Size         = UDim2.new(1,-20,0,20),
                    Position     = UDim2.new(0,10,0,6),
                    BackgroundTransparency=1,
                    Font         = Enum.Font.GothamSemibold,
                    TextSize     = Theme.FontElement,
                    TextColor3   = Theme.TextPrimary,
                    TextXAlignment= Enum.TextXAlignment.Left,
                    Parent       = row,
                })

                if desc then
                    New("TextLabel", {
                        Text         = desc,
                        Size         = UDim2.new(1,-20,0,16),
                        Position     = UDim2.new(0,10,0,24),
                        BackgroundTransparency=1,
                        Font         = Enum.Font.Gotham,
                        TextSize     = Theme.FontSub,
                        TextColor3   = Theme.TextSecond,
                        TextXAlignment= Enum.TextXAlignment.Left,
                        Parent       = row,
                    })
                end

                -- Right arrow indicator
                New("TextLabel", {
                    Text         = "▶",
                    Size         = UDim2.new(0,20,1,0),
                    Position     = UDim2.new(1,-24,0,0),
                    BackgroundTransparency=1,
                    Font         = Enum.Font.Gotham,
                    TextSize     = 10,
                    TextColor3   = Theme.Accent,
                    TextXAlignment= Enum.TextXAlignment.Center,
                    Parent       = row,
                })

                local btn = New("TextButton", {
                    Text             = "",
                    Size             = UDim2.new(1,0,1,0),
                    BackgroundTransparency=1,
                    Parent           = row,
                })
                btn.MouseButton1Click:Connect(function()
                    Tween(row, {0.08}, { BackgroundColor3 = Theme.BG_Active })
                    task.delay(0.12, function()
                        Tween(row, {0.12}, { BackgroundColor3 = Theme.BG_Element })
                    end)
                    pcall(callback)
                end)
                btn.MouseEnter:Connect(function()
                    Tween(row, {0.1}, { BackgroundColor3 = Theme.BG_Hover })
                end)
                btn.MouseLeave:Connect(function()
                    Tween(row, {0.1}, { BackgroundColor3 = Theme.BG_Element })
                end)
            end

            -- ───────────────────────────────────────
            --  DROPDOWN
            -- ───────────────────────────────────────
            function SectionObj:AddDropdown(cfg)
                cfg = cfg or {}
                local name     = cfg.Name     or "Dropdown"
                local options  = cfg.Options  or {}
                local default  = cfg.Default  or (options[1] or "None")
                local callback = cfg.Callback or function() end
                local value    = default

                local row = NewElementRow(name, 32)
                local open = false

                local display = New("TextButton", {
                    Text             = value .. "  ▾",
                    Size             = UDim2.new(0,120,0,24),
                    Position         = UDim2.new(1,-128,0.5,-12),
                    BackgroundColor3 = Theme.BG_Active,
                    BorderSizePixel  = 0,
                    Font             = Enum.Font.Gotham,
                    TextSize         = Theme.FontSub,
                    TextColor3       = Theme.TextPrimary,
                    Parent           = row,
                })
                New("UICorner", { CornerRadius = UDim.new(0,5) }).Parent = display
                New("UIStroke", { Color = Theme.Border, Thickness = 1 }).Parent = display

                -- Dropdown panel (outside section)
                local panel = New("Frame", {
                    Name             = "DropPanel",
                    Size             = UDim2.new(0,130,0,0),
                    BackgroundColor3 = Theme.BG_Panel,
                    BorderSizePixel  = 0,
                    Visible          = false,
                    ZIndex           = 20,
                    Parent           = ScreenGui,
                })
                New("UICorner",   { CornerRadius = UDim.new(0,7) }).Parent = panel
                New("UIStroke",   { Color = Theme.BorderAccent, Thickness = 1 }).Parent = panel
                New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }).Parent = panel
                New("UIPadding",  { PaddingTop=UDim.new(0,4), PaddingBottom=UDim.new(0,4) }).Parent = panel

                local optBtns = {}
                for _, opt in ipairs(options) do
                    local ob = New("TextButton", {
                        Text             = opt,
                        Size             = UDim2.new(1,0,0,26),
                        BackgroundColor3 = Theme.BG_Panel,
                        BorderSizePixel  = 0,
                        Font             = Enum.Font.Gotham,
                        TextSize         = Theme.FontSub,
                        TextColor3       = opt == value and Theme.TextAccent or Theme.TextPrimary,
                        ZIndex           = 21,
                        Parent           = panel,
                    })
                    ob.MouseButton1Click:Connect(function()
                        value = opt
                        display.Text = opt .. "  ▾"
                        open = false
                        panel.Visible = false
                        for _, b in ipairs(optBtns) do
                            b.TextColor3 = Theme.TextPrimary
                        end
                        ob.TextColor3 = Theme.TextAccent
                        pcall(callback, opt)
                    end)
                    ob.MouseEnter:Connect(function()
                        Tween(ob, {0.08}, { BackgroundColor3 = Theme.BG_Hover })
                    end)
                    ob.MouseLeave:Connect(function()
                        Tween(ob, {0.08}, { BackgroundColor3 = Theme.BG_Panel })
                    end)
                    table.insert(optBtns, ob)
                end

                display.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        local abs = display.AbsolutePosition
                        local h   = 26 * #options + 8
                        panel.Position = UDim2.new(0, abs.X, 0, abs.Y + 28)
                        panel.Size     = UDim2.new(0, 130, 0, 0)
                        panel.Visible  = true
                        Tween(panel, {0.18}, { Size = UDim2.new(0, 130, 0, h) })
                    else
                        Tween(panel, {0.15}, { Size = UDim2.new(0, 130, 0, 0) })
                        task.delay(0.15, function() panel.Visible = false end)
                    end
                end)

                local dropObj = {}
                function dropObj:Set(v)
                    value = v
                    display.Text = v .. "  ▾"
                    pcall(callback, v)
                end
                function dropObj:Get() return value end
                function dropObj:SetOptions(newOptions)
                    -- Update options list
                    for _, ob in ipairs(optBtns) do ob:Destroy() end
                    table.clear(optBtns)
                    for _, opt in ipairs(newOptions) do
                        local ob = New("TextButton", {
                            Text = opt, Size = UDim2.new(1,0,0,26),
                            BackgroundColor3 = Theme.BG_Panel,
                            BorderSizePixel = 0,
                            Font = Enum.Font.Gotham,
                            TextSize = Theme.FontSub,
                            TextColor3 = Theme.TextPrimary,
                            ZIndex = 21, Parent = panel,
                        })
                        ob.MouseButton1Click:Connect(function()
                            value = opt
                            display.Text = opt .. "  ▾"
                            open = false panel.Visible = false
                            pcall(callback, opt)
                        end)
                        table.insert(optBtns, ob)
                    end
                end
                return dropObj
            end

            -- ───────────────────────────────────────
            --  INPUT (TextBox)
            -- ───────────────────────────────────────
            function SectionObj:AddInput(cfg)
                cfg = cfg or {}
                local name        = cfg.Name        or "Input"
                local placeholder = cfg.Placeholder or "Type here..."
                local default     = cfg.Default     or ""
                local callback    = cfg.Callback    or function() end
                local numbersOnly = cfg.NumbersOnly or false

                local row = NewElementRow(name, 32)

                local box = New("TextBox", {
                    Text             = default,
                    PlaceholderText  = placeholder,
                    Size             = UDim2.new(0,130,0,24),
                    Position         = UDim2.new(1,-138,0.5,-12),
                    BackgroundColor3 = Theme.BG_Active,
                    BorderSizePixel  = 0,
                    Font             = Enum.Font.Gotham,
                    TextSize         = Theme.FontSub,
                    TextColor3       = Theme.TextPrimary,
                    PlaceholderColor3= Theme.TextDisabled,
                    ClearTextOnFocus = false,
                    Parent           = row,
                })
                New("UICorner", { CornerRadius = UDim.new(0,5) }).Parent = box
                New("UIStroke", { Color = Theme.Border, Thickness = 1 }).Parent = box
                New("UIPadding", { PaddingLeft = UDim.new(0,6), PaddingRight = UDim.new(0,6) }).Parent = box

                local stroke = box:FindFirstChildOfClass("UIStroke")
                box.Focused:Connect(function()
                    Tween(stroke, {0.12}, { Color = Theme.Accent })
                end)
                box.FocusLost:Connect(function(enter)
                    Tween(stroke, {0.12}, { Color = Theme.Border })
                    pcall(callback, box.Text)
                end)

                if numbersOnly then
                    box:GetPropertyChangedSignal("Text"):Connect(function()
                        box.Text = box.Text:gsub("[^%d%.%-]","")
                    end)
                end

                local inputObj = {}
                function inputObj:Set(v) box.Text = v end
                function inputObj:Get() return box.Text end
                return inputObj
            end

            -- ───────────────────────────────────────
            --  LABEL
            -- ───────────────────────────────────────
            function SectionObj:AddLabel(text, color)
                local lbl = New("TextLabel", {
                    Text             = text or "Label",
                    Size             = UDim2.new(1,0,0,22),
                    BackgroundTransparency=1,
                    Font             = Enum.Font.Gotham,
                    TextSize         = Theme.FontSub,
                    TextColor3       = color or Theme.TextSecond,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                    LayoutOrder      = layoutOrder,
                    Parent           = Section,
                })
                New("UIPadding", { PaddingLeft = UDim.new(0,10) }).Parent = lbl
                layoutOrder += 1

                local lblObj = {}
                function lblObj:Set(t) lbl.Text = t end
                function lblObj:SetColor(c) lbl.TextColor3 = c end
                return lblObj
            end

            -- ───────────────────────────────────────
            --  KEYBIND
            -- ───────────────────────────────────────
            function SectionObj:AddKeybind(cfg)
                cfg = cfg or {}
                local name     = cfg.Name     or "Keybind"
                local default  = cfg.Default  or Enum.KeyCode.Unknown
                local callback = cfg.Callback or function() end
                local key      = default
                local listening= false

                local row = NewElementRow(name)

                local keyBtn = New("TextButton", {
                    Text             = "["..key.Name.."]",
                    Size             = UDim2.new(0,90,0,24),
                    Position         = UDim2.new(1,-98,0.5,-12),
                    BackgroundColor3 = Theme.BG_Active,
                    BorderSizePixel  = 0,
                    Font             = Enum.Font.GothamSemibold,
                    TextSize         = Theme.FontSub,
                    TextColor3       = Theme.TextAccent,
                    Parent           = row,
                })
                New("UICorner", { CornerRadius = UDim.new(0,5) }).Parent = keyBtn
                New("UIStroke", { Color = Theme.Border, Thickness = 1 }).Parent = keyBtn

                keyBtn.MouseButton1Click:Connect(function()
                    listening = true
                    keyBtn.Text = "[...]"
                    keyBtn.TextColor3 = Theme.Yellow
                end)

                UserInputService.InputBegan:Connect(function(input, gpe)
                    if listening then
                        listening = false
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            key = input.KeyCode
                            keyBtn.Text = "["..key.Name.."]"
                            keyBtn.TextColor3 = Theme.TextAccent
                        end
                    elseif not gpe and input.KeyCode == key then
                        pcall(callback)
                    end
                end)

                local kbObj = {}
                function kbObj:Set(k) key = k keyBtn.Text = "["..k.Name.."]" end
                function kbObj:Get() return key end
                return kbObj
            end

            -- ───────────────────────────────────────
            --  COLOR PICKER (basic)
            -- ───────────────────────────────────────
            function SectionObj:AddColorPicker(cfg)
                cfg = cfg or {}
                local name     = cfg.Name     or "Color"
                local default  = cfg.Default  or Color3.fromRGB(0,240,180)
                local callback = cfg.Callback or function() end
                local value    = default

                local row = NewElementRow(name)

                local preview = New("TextButton", {
                    Text             = "",
                    Size             = UDim2.new(0,28,0,20),
                    Position         = UDim2.new(1,-36,0.5,-10),
                    BackgroundColor3 = value,
                    BorderSizePixel  = 0,
                    Parent           = row,
                })
                New("UICorner", { CornerRadius = UDim.new(0,5) }).Parent = preview
                New("UIStroke", { Color = Theme.Border, Thickness = 1 }).Parent = preview

                -- Open picker panel
                local panel = New("Frame", {
                    Size             = UDim2.new(0,200,0,160),
                    BackgroundColor3 = Theme.BG_Panel,
                    BorderSizePixel  = 0,
                    Visible          = false,
                    ZIndex           = 25,
                    Parent           = ScreenGui,
                })
                New("UICorner",  { CornerRadius = UDim.new(0,8) }).Parent = panel
                New("UIStroke",  { Color = Theme.BorderAccent, Thickness = 1 }).Parent = panel
                New("UIPadding", { PaddingTop=UDim.new(0,8), PaddingLeft=UDim.new(0,8), PaddingRight=UDim.new(0,8) }).Parent = panel
                New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,6) }).Parent = panel

                local labels = {"R","G","B"}
                local rgb = {math.floor(value.R*255), math.floor(value.G*255), math.floor(value.B*255)}
                local sliderRefs = {}

                for i, ch in ipairs(labels) do
                    local slRow = New("Frame", { Size=UDim2.new(1,0,0,28), BackgroundTransparency=1, LayoutOrder=i, Parent=panel })
                    New("TextLabel", { Text=ch, Size=UDim2.new(0,14,1,0), BackgroundTransparency=1,
                        Font=Enum.Font.GothamBold, TextSize=12, TextColor3=Theme.TextAccent,
                        TextXAlignment=Enum.TextXAlignment.Left, Parent=slRow })
                    local numLbl = New("TextLabel", { Text=tostring(rgb[i]), Size=UDim2.new(0,28,1,0),
                        Position=UDim2.new(1,-28,0,0), BackgroundTransparency=1,
                        Font=Enum.Font.Gotham, TextSize=11, TextColor3=Theme.TextSecond,
                        TextXAlignment=Enum.TextXAlignment.Right, Parent=slRow })
                    local trackBg = New("Frame", { Size=UDim2.new(1,-48,0,6), Position=UDim2.new(0,18,0.5,-3),
                        BackgroundColor3=Theme.BG_Active, BorderSizePixel=0, Parent=slRow })
                    New("UICorner", { CornerRadius=UDim.new(1,0) }).Parent = trackBg
                    local fill = New("Frame", { Size=UDim2.new(rgb[i]/255,0,1,0),
                        BackgroundColor3=Theme.Accent, BorderSizePixel=0, Parent=trackBg })
                    New("UICorner", { CornerRadius=UDim.new(1,0) }).Parent = fill
                    sliderRefs[i] = { fill=fill, numLbl=numLbl }

                    local sl = false
                    local function update(input)
                        local p = math.clamp((input.Position.X - trackBg.AbsolutePosition.X)/trackBg.AbsoluteSize.X,0,1)
                        rgb[i] = math.floor(p*255)
                        fill.Size = UDim2.new(p,0,1,0)
                        numLbl.Text = tostring(rgb[i])
                        local c = Color3.fromRGB(rgb[1],rgb[2],rgb[3])
                        value = c
                        preview.BackgroundColor3 = c
                        pcall(callback, c)
                    end
                    trackBg.InputBegan:Connect(function(inp)
                        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
                            sl=true update(inp)
                        end
                    end)
                    UserInputService.InputChanged:Connect(function(inp)
                        if sl and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then update(inp) end
                    end)
                    UserInputService.InputEnded:Connect(function(inp)
                        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sl=false end
                    end)
                end

                -- Apply button
                local applyBtn = New("TextButton", { Text="Apply", Size=UDim2.new(1,0,0,26), LayoutOrder=4,
                    BackgroundColor3=Theme.AccentDark, BorderSizePixel=0,
                    Font=Enum.Font.GothamBold, TextSize=12, TextColor3=Theme.BG_Dark, ZIndex=26, Parent=panel })
                New("UICorner", { CornerRadius=UDim.new(0,5) }).Parent = applyBtn
                applyBtn.MouseButton1Click:Connect(function()
                    panel.Visible = false
                end)

                preview.MouseButton1Click:Connect(function()
                    local abs = preview.AbsolutePosition
                    panel.Position = UDim2.new(0, abs.X - 80, 0, abs.Y + 30)
                    panel.Visible = not panel.Visible
                end)

                local cpObj = {}
                function cpObj:Set(c)
                    value = c
                    preview.BackgroundColor3 = c
                    rgb = {math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255)}
                    for i,ref in ipairs(sliderRefs) do
                        ref.fill.Size = UDim2.new(rgb[i]/255,0,1,0)
                        ref.numLbl.Text = tostring(rgb[i])
                    end
                    pcall(callback, c)
                end
                function cpObj:Get() return value end
                return cpObj
            end

            return SectionObj
        end -- AddSection

        return TabObj
    end -- AddTab

    -- ══════════════════════════════════════════════════
    --  NOTIFICATION
    -- ══════════════════════════════════════════════════
    local notifY = 20
    function MortyLib:Notify(cfg)
        cfg = cfg or {}
        local title    = cfg.Title    or "MortyLib"
        local message  = cfg.Message  or ""
        local duration = cfg.Duration or 3
        local ntype    = cfg.Type     or "info" -- "info"|"success"|"warn"|"error"

        local colors = {
            info    = Theme.Accent,
            success = Color3.fromRGB(0,220,120),
            warn    = Theme.Yellow,
            error   = Theme.Red,
        }
        local accentColor = colors[ntype] or Theme.Accent

        local card = New("Frame", {
            Size             = UDim2.new(0, 260, 0, 60),
            Position         = UDim2.new(1,-280, 0, notifY),
            BackgroundColor3 = Theme.BG_Panel,
            BorderSizePixel  = 0,
            ZIndex           = 100,
            Parent           = ScreenGui,
        })
        New("UICorner",  { CornerRadius = UDim.new(0,9) }).Parent = card
        New("UIStroke",  { Color = accentColor, Thickness = 1.5 }).Parent = card

        -- Side bar
        New("Frame", {
            Size             = UDim2.new(0,4,1,-16),
            Position         = UDim2.new(0,0,0,8),
            BackgroundColor3 = accentColor,
            BorderSizePixel  = 0,
            Parent           = card,
        }).Parent = card
        New("UICorner", { CornerRadius = UDim.new(0,2) }).Parent = card:GetChildren()[#card:GetChildren()]

        New("TextLabel", {
            Text         = title,
            Size         = UDim2.new(1,-18,0,20),
            Position     = UDim2.new(0,14,0,8),
            BackgroundTransparency=1,
            Font         = Enum.Font.GothamBold,
            TextSize     = 13,
            TextColor3   = accentColor,
            TextXAlignment= Enum.TextXAlignment.Left,
            ZIndex       = 101,
            Parent       = card,
        })
        New("TextLabel", {
            Text         = message,
            Size         = UDim2.new(1,-18,0,24),
            Position     = UDim2.new(0,14,0,28),
            BackgroundTransparency=1,
            Font         = Enum.Font.Gotham,
            TextSize     = 11,
            TextColor3   = Theme.TextSecond,
            TextXAlignment= Enum.TextXAlignment.Left,
            TextWrapped  = true,
            ZIndex       = 101,
            Parent       = card,
        })

        -- Progress bar
        local prog = New("Frame", {
            Size             = UDim2.new(1,0,0,2),
            Position         = UDim2.new(0,0,1,-2),
            BackgroundColor3 = accentColor,
            BorderSizePixel  = 0,
            ZIndex           = 102,
            Parent           = card,
        })
        New("UICorner", { CornerRadius = UDim.new(0,2) }).Parent = prog

        notifY = notifY + 70

        -- Slide in
        card.Position = UDim2.new(1,10,0,notifY - 70)
        Tween(card, {0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out},
            { Position = UDim2.new(1,-280,0,notifY - 70) })

        -- Progress drain
        Tween(prog, {duration, Enum.EasingStyle.Linear},
            { Size = UDim2.new(0,0,0,2) })

        task.delay(duration, function()
            Tween(card, {0.25}, { Position = UDim2.new(1,10,0,notifY-70), BackgroundTransparency=1 })
            task.wait(0.3)
            card:Destroy()
            notifY = notifY - 70
        end)
    end

    return WindowObj
end

-- Expose Theme for advanced customisation
function MortyLib:GetTheme()
    return Theme
end

function MortyLib:SetTheme(customTheme)
    for k,v in pairs(customTheme) do
        Theme[k] = v
    end
end

return MortyLib
