--[[
    MortyHub UI Library v1.0.0
    "Mucho más que una interfaz, una experiencia."
    
    Características:
    - Glassmorphism & CanvasGroup Rendering
    - Motor de Animación de Resortes (Springs)
    - Sistema de Temas Dinámicos
    - Arrastre Fluido y Optimizado
]]

local MortyHub = {}
MortyHub.__index = MortyHub

-- [ SERVICIOS ]
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

-- [ UTILIDADES ]
local function CreateElement(className, properties, children)
    local element = Instance.new(className)
    for prop, value in pairs(properties) do
        element[prop] = value
    end
    if children then
        for _, child in pairs(children) do
            child.Parent = element
        end
    end
    return element
end

local function ApplySpring(object, property, targetValue, damping, stiffness)
    local velocity = 0
    local current = object[property]
    
    local connection
    connection = RunService.RenderStepped:Connect(function(dt)
        local force = (targetValue - current) * (stiffness or 0.1)
        velocity = (velocity + force) * (damping or 0.8)
        current = current + velocity
        
        object[property] = current
        
        if math.abs(targetValue - current) < 0.001 and math.abs(velocity) < 0.001 then
            object[property] = targetValue
            connection:Disconnect()
        end
    end)
end

-- [ TEMAS ]
local Themes = {
    Default = {
        Main = Color3.fromRGB(15, 15, 17),
        Secondary = Color3.fromRGB(22, 22, 25),
        Accent = Color3.fromRGB(138, 43, 226),
        Text = Color3.fromRGB(255, 255, 255),
        TextMuted = Color3.fromRGB(150, 150, 155),
        Border = Color3.fromRGB(45, 45, 50),
        GlassTransparency = 0.1
    }
}

-- [ NÚCLEO ]
function MortyHub.new(config)
    local self = setmetatable({}, MortyHub)
    
    self.Title = config.Title or "MortyHub"
    self.Theme = Themes[config.Theme] or Themes.Default
    
    -- Crear Contenedor Principal
    self.Gui = CreateElement("ScreenGui", {
        Name = "MortyHub_" .. self.Title,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    })
    
    pcall(function() self.Gui.Parent = CoreGui end)
    if not self.Gui.Parent then self.Gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end
    
    return self
end

function MortyHub:CreateWindow(size)
    size = size or UDim2.new(0, 600, 0, 400)
    
    -- Frame Principal (CanvasGroup para efectos de grupo)
    local MainFrame = CreateElement("CanvasGroup", {
        Size = UDim2.new(0, size.X.Offset - 40, 0, size.Y.Offset - 40),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = self.Theme.Main,
        GroupTransparency = 1,
        BorderSizePixel = 0,
        Parent = self.Gui
    }, {
        CreateElement("UICorner", { CornerRadius = UDim.new(0, 14) }),
        CreateElement("UIStroke", { 
            Color = self.Theme.Border, 
            Thickness = 1.2, 
            Transparency = 0.5 
        })
    })

    -- Barra Lateral
    local Sidebar = CreateElement("Frame", {
        Size = UDim2.new(0, 180, 1, 0),
        BackgroundColor3 = self.Theme.Secondary,
        BorderSizePixel = 0,
        Parent = MainFrame
    }, {
        CreateElement("UICorner", { CornerRadius = UDim.new(0, 14) }),
        CreateElement("Frame", { -- Tapa el redondeado derecho del sidebar
            Size = UDim2.new(0, 20, 1, 0),
            Position = UDim2.new(1, -20, 0, 0),
            BackgroundColor3 = self.Theme.Secondary,
            BorderSizePixel = 0
        })
    })

    -- Contenedor de Título
    local TitleLabel = CreateElement("TextLabel", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundTransparency = 1,
        Text = self.Title,
        TextColor3 = self.Theme.Accent,
        TextSize = 22,
        Font = Enum.Font.GothamBold,
        Parent = Sidebar
    })

    -- Contenedor de Contenido
    local ContentFrame = CreateElement("Frame", {
        Size = UDim2.new(1, -180, 1, 0),
        Position = UDim2.new(0, 180, 0, 0),
        BackgroundTransparency = 1,
        Parent = MainFrame
    })

    -- Animación de Entrada
    TweenService:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
        Size = size,
        GroupTransparency = 0
    }):Play()

    -- Funcionalidad de Arrastre
    local dragging, dragInput, dragStart, startPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)

    RunService.RenderStepped:Connect(function()
        if dragging and dragInput then
            local delta = dragInput.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    local Window = {
        Elements = {},
        CurrentTab = nil
    }

    function Window:CreateButton(text, callback)
        local ButtonFrame = CreateElement("TextButton", {
            Size = UDim2.new(0.9, 0, 0, 40),
            BackgroundColor3 = self.Theme.Secondary,
            Text = text,
            TextColor3 = self.Theme.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 14,
            AutoButtonColor = false,
            Parent = ContentFrame
        }, {
            CreateElement("UICorner", { CornerRadius = UDim.new(0, 8) }),
            CreateElement("UIStroke", { Color = self.Theme.Border, Thickness = 1 })
        })

        ButtonFrame.MouseButton1Click:Connect(function()
            -- Efecto de pulsación
            ButtonFrame.Size = UDim2.new(0.85, 0, 0, 38)
            TweenService:Create(ButtonFrame, TweenInfo.new(0.2), { Size = UDim2.new(0.9, 0, 0, 40) }):Play()
            callback()
        end)

        return ButtonFrame
    end

    return Window
end

return MortyHub
