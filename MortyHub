    local function SetActiveTab(tab)
        if activeTab then
            activeTab._btn.BackgroundColor3 = Theme.BG_Element
            activeTab._btn.TextColor3 = Theme.TextSecond
            activeTab._content.Visible = false
            -- Stroke off
            local s = activeTab._btn:FindFirstChildOfClass("UIStroke")
