            })

            local layoutOrder = 1

            -- ═══════════════════════════════════════
            --  Element Helpers
            -- ═══════════════════════════════════════
            local SectionObj = {}

            local function NewElementRow(name, height)
                height = height or 32
                local row = New("Frame", {
                    Size             = UDim2.new(1,0,0,height),
                    BackgroundColor3 = Theme.BG_Element,
                    BorderSizePixel  = 0,
                    LayoutOrder      = layoutOrder,
                    Parent           = Section,
                })
                New("UICorner",  { CornerRadius = UDim.new(0,6) }).Parent = row
                layoutOrder += 1

                New("TextLabel", {
                    Name         = "Label",
                    Text         = name,
                    Size         = UDim2.new(0.55,0,1,0),
                    Position     = UDim2.new(0,10,0,0),
                    BackgroundTransparency=1,
                    Font         = Enum.Font.Gotham,
                    TextSize     = Theme.FontElement,
                    TextColor3   = Theme.TextPrimary,
                    TextXAlignment= Enum.TextXAlignment.Left,
                    Parent       = row,
                })
                return row
            end

            -- ───────────────────────────────────────
            --  TOGGLE
            -- ───────────────────────────────────────
            function SectionObj:AddToggle(cfg)
                cfg = cfg or {}
                local name     = cfg.Name     or "Toggle"
                local default  = cfg.Default  or false
                local callback = cfg.Callback or function() end
                local value    = default

                local row = NewElementRow(name)

                local track = New("Frame", {
                    Size             = UDim2.new(0,38,0,20),
                    Position         = UDim2.new(1,-48,0.5,-10),
                    BackgroundColor3 = value and Theme.Enabled or Theme.Disabled,
                    BorderSizePixel  = 0,
                    Parent           = row,
                })
                New("UICorner", { CornerRadius = UDim.new(1,0) }).Parent = track

                local knob = New("Frame", {
                    Size             = UDim2.new(0,16,0,16),
                    Position         = UDim2.new(value and 1 or 0, value and -18 or 2, 0.5,-8),
                    BackgroundColor3 = Color3.fromRGB(255,255,255),
                    BorderSizePixel  = 0,
                    Parent           = track,
                })
                New("UICorner", { CornerRadius = UDim.new(1,0) }).Parent = knob

                local function SetToggle(v)
                    value = v
                    Tween(track, {0.15}, { BackgroundColor3 = v and Theme.Enabled or Theme.Disabled })
                    Tween(knob,  {0.15}, { Position = v
                        and UDim2.new(1,0,-18,0.5,-8)
                        or  UDim2.new(0,2,0.5,-8) })
                    pcall(callback, v)
                end

                -- Click area
                local btn = New("TextButton", {
                    Text = "",
                    Size = UDim2.new(1,0,1,0),
                    BackgroundTransparency = 1,
                    Parent = row,
                })
                btn.MouseButton1Click:Connect(function()
                    SetToggle(not value)
                end)

                -- Hover
                btn.MouseEnter:Connect(function()
                    Tween(row, {0.1}, { BackgroundColor3 = Theme.BG_Hover })
                end)
                btn.MouseLeave:Connect(function()
                    Tween(row, {0.1}, { BackgroundColor3 = Theme.BG_Element })
                end)

                local toggleObj = {}
                function toggleObj:Set(v) SetToggle(v) end
                function toggleObj:Get() return value end
                return toggleObj
            end

            -- ───────────────────────────────────────
            --  SLIDER
            -- ───────────────────────────────────────
            function SectionObj:AddSlider(cfg)
                cfg = cfg or {}
                local name     = cfg.Name     or "Slider"
                local min      = cfg.Min      or 0
                local max      = cfg.Max      or 100
                local default  = cfg.Default  or min
                local suffix   = cfg.Suffix   or ""
                local callback = cfg.Callback or function() end
                local value    = math.clamp(default, min, max)

                local row = NewElementRow(name, 44)

                local valLabel = New("TextLabel", {
                    Text         = tostring(value)..suffix,
                    Size         = UDim2.new(0,50,0,20),
                    Position     = UDim2.new(1,-58,0,6),
                    BackgroundTransparency=1,
                    Font         = Enum.Font.GothamSemibold,
                    TextSize     = Theme.FontSub,
                    TextColor3   = Theme.TextAccent,
                    TextXAlignment= Enum.TextXAlignment.Right,
                    Parent       = row,
                })

                local trackBg = New("Frame", {
                    Size             = UDim2.new(1,-20,0,6),
                    Position         = UDim2.new(0,10,1,-14),
                    BackgroundColor3 = Theme.BG_Active,
                    BorderSizePixel  = 0,
                    Parent           = row,
                })
                New("UICorner", { CornerRadius = UDim.new(1,0) }).Parent = trackBg

                local pct = (value - min) / (max - min)
                local fill = New("Frame", {
                    Size             = UDim2.new(pct,0,1,0),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel  = 0,
                    Parent           = trackBg,
                })
                New("UICorner", { CornerRadius = UDim.new(1,0) }).Parent = fill

                local function SetSlider(v)
                    v = math.clamp(math.round(v), min, max)
                    value = v
                    local p = (v - min) / (max - min)
                    Tween(fill, {0.05}, { Size = UDim2.new(p, 0, 1, 0) })
                    valLabel.Text = tostring(v)..suffix
                    pcall(callback, v)
                end

                local sliding = false
                local function OnInput(input)
                    local abs = trackBg.AbsolutePosition
                    local sz  = trackBg.AbsoluteSize
                    local pxPct = math.clamp((input.Position.X - abs.X) / sz.X, 0, 1)
                    SetSlider(min + pxPct * (max - min))
                end

                trackBg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        OnInput(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        OnInput(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)

                local sliderObj = {}
                function sliderObj:Set(v) SetSlider(v) end
                function sliderObj:Get() return value end
                return sliderObj
            end

            -- ───────────────────────────────────────
            --  BUTTON
            -- ───────────────────────────────────────
            function SectionObj:AddButton(cfg)
