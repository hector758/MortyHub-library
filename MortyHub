        end
        activeTab = tab
        tab._btn.BackgroundColor3 = Theme.BG_Active
        tab._btn.TextColor3 = Theme.TextAccent
        tab._content.Visible = true
        local s = tab._btn:FindFirstChildOfClass("UIStroke")
        if s then s.Color = Theme.Accent s.Thickness = 1.5 end
    end

